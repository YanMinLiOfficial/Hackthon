# 复制为 .env.local 后填写；不填时地图使用本地 SVG 模拟地图，核心演示不受影响。
# 高德 JS API Key（预留入口，MVP 不联网、不强制配置）
VITE_AMAP_API_KEY=
VITE_AMAP_SECURITY_CODE=

# DeepSeek 仅由本地 Vite/preview 代理读取；不要添加 VITE_ 前缀，否则会暴露到浏览器。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 本地 Whisper，可留空复用 ~/.bilibili-mcp/asr；其他机器填写本机安装路径。
LOCAL_ASR_PYTHON=
LOCAL_ASR_MODEL=
